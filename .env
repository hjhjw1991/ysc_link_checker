# Logger
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ---- 本地独立运行（脱离 Lark aPaaS 平台）所需 ----
# 平台 HTTP 客户端要求一个基础域名；本项目不调用平台内部 API，占位即可
FORCE_AUTHN_INNERAPI_DOMAIN=http://127.0.0.1:1
# 本项目不使用数据库，跳过平台 DataPaaS 连接初始化
DEPRECATED_SKIP_INIT_DB_CONNECTION=true
SERVER_PORT=3000
CLIENT_DEV_PORT=8080
# 让后端把本地请求当成「自定义域名」入口，前端路由 basename 回到 /
LOCAL_STANDALONE=1
